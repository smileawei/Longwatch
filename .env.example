# Longbridge OAuth（唯一认证方式；client_id 不是密码）
LONGBRIDGE_OAUTH_CLIENT_ID=
LONGBRIDGE_OAUTH_CALLBACK_PORT=60355

# 中国大陆网络可设为 cn；美国账户必须使用默认 .com 接入点
# LONGBRIDGE_REGION=cn
LONGBRIDGE_LANGUAGE=zh-CN

# Bark App 中测试 URL 的 key 部分，例如 https://api.day.app/abc123 中的 abc123
BARK_DEVICE_KEY=
BARK_SERVER_URL=https://api.day.app
BARK_GROUP=LongWatch
BARK_LEVEL=timeSensitive
BARK_SOUND=
# Bark 通知点击后打开的网页地址；手机必须能够访问此地址
ALERT_DETAIL_BASE_URL=http://127.0.0.1:8765
# 公网告警专用域名；设置后该 Host 仅允许有效 token 的单股告警请求
ALERT_PUBLIC_HOST=
# 首次启动时自动生成，用于签署每条告警的 24 小时随机访问 token；请勿分享
ALERT_LINK_SECRET=

# 监控参数（百分比均填写正数）
POLL_INTERVAL_SECONDS=30
POSITIONS_REFRESH_SECONDS=300
DAY_RISE_PCT=3
DAY_FALL_PCT=3
COST_GAIN_PCT=10
COST_LOSS_PCT=5
# 回落/反弹超过此幅度后，才允许同一规则再次告警
ALERT_HYSTERESIS_PCT=0.3
# true 时默认使用时间戳最新的盘前/盘后/夜盘价格
INCLUDE_EXTENDED_HOURS=true
LONGBRIDGE_ENABLE_OVERNIGHT=true
QUOTE_BATCH_SIZE=50
STATE_FILE=data/state.json
LOG_LEVEL=INFO

# K 线网页服务（默认只允许本机访问；Docker 中需改为 0.0.0.0）
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
# 手机访问时可改为局域网地址，例如 http://192.168.1.100:8765，并将 HTTP_HOST 改为 0.0.0.0
